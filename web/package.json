{
  "name": "mandate-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "predev": "npm run build:mcp",
    "prestart": "npm run build:mcp",
    "build:mcp": "cd ../mcp-server && npm run build",
    "build": "npm run build:mcp && next build",
    "start": "next start -p 3000",
