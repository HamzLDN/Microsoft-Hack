# Mandate on hamza's host (copy to repo root .env and/or mobile/.env as needed)

# Server LAN address + public app port (Next.js listens here in production)
MANDATE_HOST=192.168.1.185
MANDATE_PUBLIC_PORT=6767
MANDATE_PUBLIC_URL=http://192.168.1.185:6767

# If your router forwards a different public IP or hostname, set this for Expo / links:
# MANDATE_PUBLIC_URL=http://YOUR_PUBLIC_IP:6767

# Web → data service (same machine)
DATA_SERVICE_URL=http://127.0.0.1:5001

# Expo (mobile/.env)
EXPO_PUBLIC_API_URL=http://192.168.1.185:6767
