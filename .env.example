# Copy to .env (never commit .env)

# Market data
FINNHUB_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT="Mandate hackathon your-email@example.com"

# LLM: Claude Opus 5.5 by default. All three analysts share one key; each can use its own model.
LLM_PROVIDER=claude
# Direct Claude API key:
ANTHROPIC_API_KEY=
# or Claude on Microsoft Foundry (resource name or full base URL):
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_BASE_URL=
CLAUDE_MODEL=claude-opus-5-5
# Optional per-analyst models, for example a faster model for markets and news:
ANALYST_MODEL_FUNDAMENTALS=
ANALYST_MODEL_MARKETS=
ANALYST_MODEL_FIT=

# Hackathon key from Microsoft (Azure OpenAI style). Only the key is required:
# endpoint, model and API version default to the hackathon gateway (https://app-uoaihack2ix6ak.azurewebsites.net, gpt-6.1-sol, 2024-12-01-preview).
# Used automatically whenever Claude is not configured.
ORGANISER_API_KEY=
ORGANISER_API_ENDPOINT=
ORGANISER_MODEL=
ORGANISER_API_VERSION=

# Fallbacks (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=

# Web app
DATA_SERVICE_URL=http://localhost:5001
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_COMPARE=0
