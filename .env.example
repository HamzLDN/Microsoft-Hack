# Copy to .env (never commit .env)

# Market data
FINNHUB_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT="Mandate hackathon your-email@example.com"

# AI: the hackathon's Azure OpenAI gateway (gpt-6.1-sol). Only the key is required, from your team page in the portal.
# Optional per-analyst models: ANALYST_MODEL_FUNDAMENTALS / ANALYST_MODEL_MARKETS / ANALYST_MODEL_FIT
# Endpoint, model and API version default to:
# endpoint, model and API version default to the hackathon gateway (https://app-uoaihack2ix6ak.azurewebsites.net, gpt-6.1-sol, 2024-12-01-preview).
ORGANISER_API_KEY=
ORGANISER_API_ENDPOINT=
ORGANISER_MODEL=
ORGANISER_API_VERSION=

# Fallbacks (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=

# Web app
DATA_SERVICE_URL=http://localhost:5001
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_COMPARE=0
