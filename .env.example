# Copy to .env (never commit .env)

# Market data
FINNHUB_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT="Mandate hackathon your-email@example.com"

# LLM (Azure OpenAI preferred; set LLM_PROVIDER=openai to use OpenAI instead)
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=

# Web app
DATA_SERVICE_URL=http://localhost:5001
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_COMPARE=0
