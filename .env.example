# Copy to .env (never commit .env)

# Market data
FINNHUB_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT="Mandate hackathon your-email@example.com"

# LLM: organiser-provided key is the default. Ask the organisers for its endpoint and model name.
LLM_PROVIDER=organiser
ORGANISER_API_KEY=
ORGANISER_API_ENDPOINT=
ORGANISER_MODEL=

# Fallbacks (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=

# Web app
DATA_SERVICE_URL=http://localhost:5001
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_COMPARE=0
