# Copy to mobile/.env and restart Expo (npm start).

# Physical phone on same Wi‑Fi as your Mac (web: npm run dev:lan)
EXPO_PUBLIC_API_URL=http://192.168.1.XXX:3000

# iOS Simulator on the same Mac
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Remote server (when reachable)
# EXPO_PUBLIC_API_URL=http://192.168.1.185:6767
